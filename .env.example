# Copy this file to .env and fill the values

PORT=3000
MASTER_SECRET=change-this-to-a-long-random-string-at-least-32-chars
ALLOWED_EXECUTOR=YourExecutorName
# Example: Fluxus, Wave, Valyse, Solara, etc.
# The exact string returned by identifyexecutor()

# Optional: force HTTPS in production
# FORCE_HTTPS=true
